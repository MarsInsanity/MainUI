{
  "version": 2,
  "_doc": [
    "get: where Apps > App Store > Emulators finds it. github: 'owner/repo' (APK of the latest release), url: direct APK,",
    "buildbot: RetroArch from retroarch.com, play: Google Play package, page: website, note: text shown. F-Droid repos are",
    "searched by package name automatically.",
    "Launch recipes for Android emulators. Copy this file to <storage>/MainUI/emulators.json to override or extend it;",
    "entries in the override file replace built-in entries with the same id.",
    "Recipes follow ES-DE's maintained Android rules (resources/systems/android/es_find_rules.xml and es_systems.xml).",
    "components: 'package/activity' pairs tried in order ('.Name' is relative to the package). The first installed one is used.",
    "Placeholders: %ROM% absolute path, %ROMURI% file:// uri, %ROMPROVIDER% content:// uri served by MainUI,",
    "%ROMSAF% Storage Access Framework document uri (the emulator needs folder access), %BASENAME% file name without",
    "extension, %GAMEDIR% folder of the rom, %FILECONTENT% first line of the rom file (Vita3K title ids), %PKG%, %CORE%,",
    "%CORE_PATH%, %RA_CONFIG%, %RPCSX_GAME% (folder of the title id's game installed in RPCSX). 'root': true starts the",
    "activity with root (for emulators that don't export it). Extras prefixed 'bool:', 'int:' or 'array:' (comma separated) are typed.",
    "ingame.states: 'api' (RetroArch network commands), 'hotkey' (MainUI injects ingame.save / ingame.load keys with root;",
    "bind the same keys in the emulator, the in-game menu's 'Bind hotkeys' sends them for you), 'menu' (only through the",
    "emulator's own menu), 'none' (no save states). ingame.menu: back | key:<KEYCODE> | none."
  ],
  "retroarch": {
    "get": { "buildbot": "true", "page": "https://www.retroarch.com/?page=platforms" },
    "name": "RetroArch",
    "packages": ["com.retroarch.aarch64", "com.retroarch", "com.retroarch.ra32"],
    "activity": "com.retroarch.browser.retroactivity.RetroActivityFuture",
    "extras": {
      "ROM": "%ROM%",
      "LIBRETRO": "%CORE_PATH%",
      "CONFIGFILE": "%RA_CONFIG%"
    },
    "_note": "Do not add QUITFOCUS: it makes RetroArch quit when it loses focus, which kills the game when the Game Switcher or MainUI opens.",
    "flags": ["NEW_TASK", "CLEAR_TASK"],
    "commandPort": 55355,
    "ingame": { "states": "api" }
  },
  "standalone": [
    {
      "id": "armsx2", "name": "ARMSX2",
      "get": { "page": "https://armsx2.net", "play": "come.nanodata.armsx2" },
      "components": [
        "come.nanodata.armsx2/com.armsx2.MainActivity",
        "com.armsx2/.MainActivity",
        "com.armsx2.nightly/com.armsx2.MainActivity",
        "come.nanodata.armsx2/kr.co.iefriends.pcsx2.MainActivity",
        "come.nanodata.armsx2.debug/kr.co.iefriends.pcsx2.MainActivity"
      ],
      "action": "android.intent.action.VIEW", "data": "%ROMSAF%", "flags": ["NEW_TASK"],
      "ingame": { "menu": "back", "states": "hotkey", "save": "keys:KEYCODE_F1", "load": "keys:KEYCODE_F3" }
    },
    {
      "id": "nethersx2", "name": "NetherSX2 / AetherSX2",
      "get": { "page": "https://github.com/Trixarian/NetherSX2-patch", "note": "Built from an AetherSX2 APK with a patch; see the page" },
      "components": [
        "xyz.aethersx2.android/.EmulationActivity",
        "xyz.aethersx2.tturnip/xyz.aethersx2.android.EmulationActivity",
        "xyz.aethersx2.cturnip/xyz.aethersx2.android.EmulationActivity"
      ],
      "action": "android.intent.action.MAIN", "extras": { "bootPath": "%ROMSAF%" },
      "flags": ["NEW_TASK", "CLEAR_TASK", "CLEAR_TOP"],
      "ingame": { "menu": "back", "states": "hotkey", "save": "keys:KEYCODE_F1", "load": "keys:KEYCODE_F3" }
    },
    {
      "id": "armsx3", "name": "ARMSX3",
      "get": { "github": "ARMSX2/ARMSX3", "note": "Disc images, game folders, or .ps3 files holding a title id (ARMSX3's frontend export)" },
      "components": ["com.armsx3/com.armsx2.Main", "com.armsx3.play/com.armsx2.Main"],
      "extras": { "path": "%ROM%" }, "flags": ["NEW_TASK"],
      "ingame": { "menu": "back", "states": "none" }
    },
    {
      "id": "rpcsx", "name": "RPCSX",
      "get": { "github": "RPCSX/rpcsx-ui-android", "note": "Starts games installed in RPCSX: put a .ps3 file holding the title id (like BLUS12345) in roms/ps3. Needs root." },
      "components": ["net.rpcsx/.RPCSXActivity"],
      "root": true,
      "extras": { "path": "%RPCSX_GAME%" }, "flags": ["NEW_TASK"],
      "ingame": { "menu": "back", "states": "none" }
    },
    {
      "id": "vita3k", "name": "Vita3K",
      "get": { "github": "Vita3K/Vita3K-Android", "page": "https://vita3k.org/", "note": "Newer builds may only be on vita3k.org" },
      "components": ["org.vita3k.emulator/.Emulator", "org.vita3k.emulator.ikhoeyZX/org.vita3k.emulator.Emulator"],
      "extras": { "AppStartParameters": "array:-r,%FILECONTENT%" }, "flags": ["NEW_TASK"],
      "ingame": { "menu": "back", "states": "none" }
    },
    {
      "id": "hakux", "name": "hakuX",
      "get": { "github": "rfandango/hakuX" },
      "components": ["com.rfandango.haku_x/.LauncherActivity"],
      "action": "android.intent.action.VIEW", "data": "%ROMSAF%", "flags": ["NEW_TASK"],
      "ingame": { "menu": "back", "states": "menu" }
    },
    {
      "id": "ppsspp", "name": "PPSSPP",
      "get": { "page": "https://www.ppsspp.org/download/", "play": "org.ppsspp.ppsspp" },
      "components": ["org.ppsspp.ppssppgold/org.ppsspp.ppsspp.PpssppActivity", "org.ppsspp.ppsspp/.PpssppActivity"],
      "action": "android.intent.action.VIEW", "category": "android.intent.category.DEFAULT", "data": "%ROMSAF%",
      "flags": ["NEW_TASK"],
      "ingame": { "menu": "back", "states": "hotkey", "save": "keys:KEYCODE_F2", "load": "keys:KEYCODE_F4" }
    },
    {
      "id": "duckstation", "name": "DuckStation",
      "get": { "play": "com.github.stenzek.duckstation", "page": "https://www.duckstation.org/" },
      "components": ["com.github.stenzek.duckstation/.EmulationActivity"],
      "extras": { "resumeState": "bool:false", "bootPath": "%ROMSAF%" },
      "flags": ["NEW_TASK", "CLEAR_TASK", "CLEAR_TOP"],
      "ingame": { "menu": "back", "states": "hotkey", "save": "keys:KEYCODE_F1", "load": "keys:KEYCODE_F2" }
    },
    {
      "id": "drastic", "name": "DraStic",
      "get": { "play": "com.dsemu.drastic", "note": "Paid app on Google Play" },
      "components": ["com.dsemu.drastic/.DraSticActivity"],
      "data": "%ROMSAF%", "flags": ["NEW_TASK", "CLEAR_TASK", "CLEAR_TOP"],
      "ingame": { "menu": "back", "states": "hotkey", "save": "keys:KEYCODE_F1", "load": "keys:KEYCODE_F2" }
    },
    {
      "id": "melonds", "name": "melonDS",
      "get": { "github": "rafaelvcaetano/melonDS-android", "play": "me.magnum.melonds" },
      "components": [
        "me.magnum.melonds/.ui.emulator.EmulatorActivity",
        "me.magnum.melondualds/me.magnum.melonds.ui.emulator.EmulatorActivity"
      ],
      "action": "me.magnum.melonds.LAUNCH_ROM", "extras": { "uri": "%ROMSAF%" }, "flags": ["NEW_TASK"],
      "ingame": { "menu": "back", "states": "hotkey", "save": "keys:KEYCODE_F1", "load": "keys:KEYCODE_F2" }
    },
    {
      "id": "melonds_nightly", "name": "melonDS Nightly",
      "get": { "page": "https://github.com/rafaelvcaetano/melonDS-android" },
      "components": ["me.magnum.melonds.nightly/me.magnum.melonds.ui.emulator.EmulatorActivity"],
      "action": "me.magnum.melonds.nightly.LAUNCH_ROM", "extras": { "uri": "%ROMSAF%" }, "flags": ["NEW_TASK"],
      "ingame": { "menu": "back", "states": "hotkey", "save": "keys:KEYCODE_F1", "load": "keys:KEYCODE_F2" }
    },
    {
      "id": "dolphin", "name": "Dolphin",
      "get": { "page": "https://dolphin-emu.org/download/", "play": "org.dolphinemu.dolphinemu" },
      "components": ["org.dolphinemu.dolphinemu/.ui.main.TvMainActivity"],
      "action": "android.intent.action.MAIN", "category": "android.intent.category.LEANBACK_LAUNCHER",
      "extras": { "AutoStartFile": "%ROMSAF%" }, "flags": ["NEW_TASK"],
      "ingame": { "menu": "back", "states": "hotkey", "save": "keys:KEYCODE_F1", "load": "keys:KEYCODE_F2" }
    },
    {
      "id": "dolphin_mmjr", "name": "Dolphin MMJR / MMJR2",
      "get": { "note": "Unofficial fork, no longer updated" },
      "components": [
        "org.dolphinemu.mmjr/org.dolphinemu.dolphinemu.ui.main.MainActivity",
        "org.mm.jr/org.dolphinemu.dolphinemu.ui.main.MainActivity"
      ],
      "action": "android.intent.action.VIEW", "extras": { "AutoStartFile": "%ROMSAF%" }, "flags": ["NEW_TASK"],
      "ingame": { "menu": "back", "states": "menu" }
    },
    {
      "id": "azahar", "name": "Azahar",
      "get": { "github": "azahar-emu/azahar", "play": "io.github.lime3ds.android" },
      "components": [
        "org.azahar_emu.azahar/org.citra.citra_emu.activities.EmulationActivity",
        "io.github.azaharplus.android/org.citra.citra_emu.activities.EmulationActivity"
      ],
      "data": "%ROMSAF%", "flags": ["NEW_TASK", "CLEAR_TASK", "CLEAR_TOP"],
      "ingame": { "menu": "back", "states": "hotkey", "save": "keys:KEYCODE_F1", "load": "keys:KEYCODE_F2" }
    },
    {
      "id": "lime3ds", "name": "Lime3DS",
      "get": { "note": "Discontinued: use Azahar" },
      "components": ["io.github.lime3ds.android/.activities.EmulationActivity"],
      "data": "%ROMSAF%", "flags": ["NEW_TASK", "CLEAR_TASK", "CLEAR_TOP"],
      "ingame": { "menu": "back", "states": "hotkey", "save": "keys:KEYCODE_F1", "load": "keys:KEYCODE_F2" }
    },
    {
      "id": "citra", "name": "Citra",
      "get": { "note": "Discontinued: use Azahar" },
      "components": ["org.citra.citra_emu/.activities.EmulationActivity", "org.citra.citra_emu.canary/org.citra.citra_emu.activities.EmulationActivity"],
      "data": "%ROMSAF%", "flags": ["NEW_TASK", "CLEAR_TASK", "CLEAR_TOP"],
      "ingame": { "menu": "back", "states": "hotkey", "save": "keys:KEYCODE_F1", "load": "keys:KEYCODE_F2" }
    },
    {
      "id": "citra_mmj", "name": "Citra MMJ",
      "get": { "note": "Discontinued: use Azahar" },
      "components": ["org.citra.emu/.ui.EmulationActivity"],
      "extras": { "GamePath": "%ROM%" }, "flags": ["NEW_TASK"],
      "ingame": { "menu": "back", "states": "menu" }
    },
    {
      "id": "redream", "name": "Redream",
      "get": { "page": "https://redream.io/download", "play": "io.recompiled.redream" },
      "components": ["io.recompiled.redream/.MainActivity"],
      "action": "android.intent.action.VIEW", "data": "%ROMSAF%", "flags": ["NEW_TASK"],
      "ingame": { "menu": "back", "states": "menu" }
    },
    {
      "id": "flycast", "name": "Flycast",
      "get": { "github": "flyinghead/flycast", "play": "com.flycast.emulator" },
      "components": ["com.flycast.emulator/com.flycast.emulator.MainActivity", "com.flycast.emulator/com.reicast.emulator.MainActivity"],
      "action": "android.intent.action.VIEW", "data": "%ROMSAF%", "flags": ["NEW_TASK"],
      "ingame": { "menu": "back", "states": "hotkey", "save": "keys:KEYCODE_F1", "load": "keys:KEYCODE_F2" }
    },
    {
      "id": "yabasanshiro2", "name": "Yaba Sanshiro 2",
      "get": { "play": "org.devmiyax.yabasanshioro2" },
      "components": [
        "org.devmiyax.yabasanshioro2.pro/org.uoyabause.android.Yabause",
        "org.devmiyax.yabasanshioro2/org.uoyabause.android.Yabause"
      ],
      "action": "android.intent.action.VIEW", "extras": { "org.uoyabause.android.FileNameUri": "%ROMSAF%" },
      "flags": ["NEW_TASK", "CLEAR_TASK", "CLEAR_TOP"],
      "ingame": { "menu": "back", "states": "menu" }
    },
    {
      "id": "m64plusfz", "name": "M64Plus FZ",
      "get": { "play": "org.mupen64plusae.v3.fzurita" },
      "components": [
        "org.mupen64plusae.v3.fzurita.pro/paulscode.android.mupen64plusae.SplashActivity",
        "org.mupen64plusae.v3.fzurita/paulscode.android.mupen64plusae.SplashActivity",
        "org.mupen64plusae.v3.fzurita.amazon/paulscode.android.mupen64plusae.SplashActivity"
      ],
      "action": "android.intent.action.VIEW", "data": "%ROMSAF%", "flags": ["NEW_TASK"],
      "ingame": { "menu": "back", "states": "hotkey", "save": "keys:KEYCODE_F1", "load": "keys:KEYCODE_F2" }
    },
    {
      "id": "mame4droid", "name": "MAME4droid",
      "get": { "github": "seleuco/MAME4droid-Current", "play": "com.seleuco.mame4d2024" },
      "components": ["com.seleuco.mame4d2024/com.seleuco.mame4droid.MAME4droid", "com.seleuco.mame4droid/.MAME4droid"],
      "action": "android.intent.action.VIEW", "data": "%ROMPROVIDER%",
      "extras": { "cli_params": "-rompath '%GAMEDIR%'" }, "flags": ["NEW_TASK"],
      "ingame": { "menu": "back", "states": "menu" }
    },
    {
      "id": "eden", "name": "Eden",
      "get": { "page": "https://eden-emu.dev" },
      "components": [
        "dev.eden.eden_emulator/org.yuzu.yuzu_emu.activities.EmulationActivity",
        "dev.legacy.eden_emulator/org.yuzu.yuzu_emu.activities.EmulationActivity",
        "dev.eden.eden_emulator.nightly/org.yuzu.yuzu_emu.activities.EmulationActivity"
      ],
      "action": "android.nfc.action.TECH_DISCOVERED", "data": "%ROMPROVIDER%", "flags": ["NEW_TASK"],
      "ingame": { "menu": "back", "states": "none" }
    },
    {
      "id": "kenjinx", "name": "Kenji-NX",
      "get": { "note": "No official download known to MainUI" },
      "components": ["org.kenjinx.android/.MainActivity"],
      "action": "org.kenjinx.android.LAUNCH_GAME", "extras": { "bootPath": "%ROMSAF%" }, "flags": ["NEW_TASK"],
      "ingame": { "menu": "back", "states": "none" }
    }
  ]
}
